# Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Postiz public API. Leave empty to draft without publishing.
# Cloud: https://api.postiz.com/public/v1   Self-hosted: https://<your-backend>/public/v1
POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=

# Optional overrides
# CMO_MODEL=claude-opus-5-5
# CMO_EFFORT=high
# CMO_WEB_SEARCH=0

# --- Running on a server (docker compose) ---
# The domain the desk is served on. DNS must point at the server.
# CMO_DOMAIN=cmo.example.com
# Sign-in password, at least 12 characters.
# CMO_PASSWORD=
# Token for cloning private repositories listed by "url" in watch.json (GitHub: a fine-grained
# token with read-only access to Contents for those repositories).
# CMO_GIT_TOKEN=
# Hours between automatic checks.
# CMO_REVIEW_EVERY_HOURS=24
